; VBScript Tree-sitter Highlight Query
; =====================================
; T001 Finding: VBScript keywords generated by ci() regex patterns (If, Then, End,
; For, Sub, Function, etc.) do NOT appear as separate anonymous token nodes in the
; parse tree. Only punctuation/operator tokens (>, =, &, etc.) are emitted as
; anonymous nodes. Therefore ["if" "then" "else"] string captures DO NOT work.
; Keyword highlighting uses #match? predicates on (identifier) nodes to catch
; keywords that the grammar promotes to named types OR to catch bare keyword-like
; identifiers that slip through as (identifier) nodes in error recovery.
; Named structural node types (block_if_statement, sub_declaration, etc.) serve as
; the primary vehicle — their child identifier nodes are caught by the specific
; field captures below (function_declaration name:, etc.).

; ── T004: Comments ──────────────────────────────────────────────────────────────

(comment) @comment
(rem_comment) @comment

; ── T005: String literals ───────────────────────────────────────────────────────

(string_literal) @string

; ── T006: Numeric and date literals ────────────────────────────────────────────

(number_literal) @number
(hex_literal) @number
(octal_literal) @number
(date_literal) @string.special

; ── T007: Built-in constants ───────────────────────────────────────────────────
; These are promoted to named node types by the grammar (token(prec(1, ci(...)))),
; so they are captured directly by node type — no #match? needed.

(boolean_literal) @constant.builtin
(nothing) @constant.builtin
(empty) @constant.builtin
(null) @constant.builtin

; ── T008: Keywords ─────────────────────────────────────────────────────────────
; Since ci() keyword tokens are not emitted as separate anonymous nodes, we use
; #match? predicates on (identifier) nodes. This catches keywords that appear
; as bare identifiers in contexts where the grammar's conflict resolution falls
; back to identifier (e.g., option explicit, on error resume next, etc.).
; Case-insensitive match covers all VBScript capitalization conventions.
;
; Control flow
((identifier) @keyword
 (#match? @keyword "^(?i:if|then|else|elseif|end|for|do|loop|while|wend|next|with|select|case|exit|each|in|step|to)$"))

; Declaration
((identifier) @keyword
 (#match? @keyword "^(?i:sub|function|class|property|dim|redim|const|set|let|call|new|get|preserve)$"))

; Error handling / options
((identifier) @keyword
 (#match? @keyword "^(?i:on|error|resume|goto|option|explicit)$"))

; ── T009: Function, Sub, Property, and Class definition names ──────────────────

(function_declaration name: (identifier) @function)
(sub_declaration name: (identifier) @function)
(property_get_statement name: (identifier) @function.method)
(property_let_statement name: (identifier) @function.method)
(property_set_statement name: (identifier) @function.method)
(class_statement name: (identifier) @type)

; ── T010: Operators ────────────────────────────────────────────────────────────

(binary_expression operator: _ @operator)
(unary_expression operator: _ @operator)

; ── T011: Identifiers, parameters, members, labels, punctuation ────────────────
; More-specific patterns above; fallbacks and punctuation below.

(declared_variable name: (identifier) @variable)
(constant_definition name: (identifier) @variable)
(parameter name: (identifier) @variable.parameter)
(member_expression property: (identifier) @property)

(line_label label: _ @label)
(goto_statement label: _ @label)
(on_error_statement label: _ @label)

"(" @punctuation.bracket
")" @punctuation.bracket
"," @punctuation.delimiter
":" @punctuation.delimiter

; Fallback: must be LAST — catches any identifier not already captured above.
(identifier) @variable
