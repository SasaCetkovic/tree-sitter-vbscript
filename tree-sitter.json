{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "vbscript",
      "camelcase": "VBScript",
      "title": "VBScript",
      "scope": "text.html.asp",
      "file-types": [
        "vbs",
        "asp"
      ],
      "injection-regex": "^vbscript$",
      "class-name": "TreeSitterVbscript"
    }
  ],
  "metadata": {
    "version": "0.3.0",
    "license": "MIT",
    "description": "VBScript grammar for the tree-sitter parsing library",
    "authors": [
      {
        "name": "Sasa Cetkovic",
        "email": "sasa.cetkovic@outlook.cz"
      }
    ],
    "links": {
      "repository": "https://github.com/SasaCetkovic/tree-sitter-vbscript"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
